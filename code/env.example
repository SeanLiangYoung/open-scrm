# ============================================
# Open SCRM Environment Variables
# 复制此文件为 .env 并修改配置
# Copy this file to .env and modify the configuration
# ============================================

# 应用密钥（生产环境请务必修改）
APP_KEYS=your_app_secret_key_here_please_change_in_production

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
# 与 docker-compose 中 postgres 服务一致时可省略其一
DB_USER=postgres
DB_USERNAME=postgres
DB_PASSWORD=root123
DB_DATABASE=scrm_dev

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_jwt_secret_key_please_change_in_production
JWT_EXPIRES_IN=7d

# ============================================
# OSS Configuration (Aliyun OSS)
# ============================================
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_PREFIX=scrm-assets
CDN_DOMAIN=

# ============================================
# WeChat Work (企业微信) Configuration
# ============================================
WEWORK_CORP_ID=your_corp_id
WEWORK_AGENT_ID=your_agent_id
WEWORK_SECRET=your_secret
WEWORK_TOKEN=your_token
WEWORK_ENCODING_AES_KEY=your_encoding_aes_key

# ============================================
# Payment Configuration (微信支付)
# ============================================
WECHAT_MCH_ID=your_merchant_id
WECHAT_API_KEY=your_api_key
WECHAT_NOTIFY_URL=https://your-domain.com/api/payment/callback

# ============================================
# LLM Wiki (local desktop app, port 19828)
# Generate token in App: Settings → API + MCP
# ============================================
LLM_WIKI_BASE_URL=http://127.0.0.1:19828
# Docker Compose 内由 compose 覆盖为 http://host.docker.internal:19828
LLM_WIKI_API_TOKEN=
LLM_WIKI_PROJECT_ID=current

# ============================================
# Content Studio (content-generation-service)
# ============================================
CONTENT_GENERATION_SERVICE_URL=http://localhost:7010
CONTENT_GENERATION_SYNC=false
# true = 不调用真实 LLM，返回固定 Mock JSON（E2E/流程调试）
# false = 使用下方 LLM_API_* 调用 OpenAI 兼容生成端点
CONTENT_GENERATION_MOCK_LLM=false
# OpenAI 兼容 LLM（compose 核心稿、generate 渠道变体）
# 国内端点示例：LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 可选；不设置则使用模型默认值（o1/o3 等推理模型仅支持默认 temperature）
# LLM_TEMPERATURE=0.7
CONTENT_PROMPT_VERSION=v1
ACQUISITION_SERVICE_URL=http://localhost:7003
PLATFORM_PUBLISH_MODE=mock
XHS_PUBLISH_MODE=mock

# ============================================
# Node Environment
# ============================================
NODE_ENV=development
