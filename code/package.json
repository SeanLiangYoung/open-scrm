{
  "name": "scrm-system",
  "version": "1.0.0",
  "private": true,
  "description": "企业SCRM私域运营系统",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter \"./apps/**\" dev",
    "dev:service": "pnpm --filter \"./services/**\" dev",
    "dev:mac": "bash ./scripts/run/start-dev-macos.sh",
    "build": "turbo run build",
    "build:web": "pnpm --filter \"./apps/**\" build",
    "build:service": "pnpm --filter \"./services/**\" build",
    "build:docker": "turbo run build --filter=\"./packages/**\" --filter=\"./services/**\"",
    "test": "bash ./scripts/test/full-test.sh",
    "test:unit": "turbo run test --filter=@scrm/shared-utils --filter=@scrm/gateway-service --filter=@scrm/auth-service --filter=@scrm/integration-service --filter=@scrm/message-service --filter=@scrm/analytics-service --filter=@scrm/operation-service",
    "test:e2e": "bash ./e2e/run-full-e2e.sh",
    "test:e2e:playwright": "pnpm --filter @scrm/e2e exec playwright test",
    "test:e2e:api": "PLAYWRIGHT_SKIP_WEBSERVER=1 pnpm --filter @scrm/e2e exec playwright test --project=sprint1-api --project=sprint2-integration --project=sprint3-messages --project=sprint4-analytics --project=sprint5-acquisition --project=sprint8-outbound",
    "test:e2e:sprint2": "bash ./e2e/run-sprint2-api.sh",
    "test:e2e:sprint3": "bash ./e2e/run-sprint3-api.sh",
    "test:e2e:sprint4": "bash ./e2e/run-sprint4-api.sh",
    "test:e2e:sprint5": "bash ./e2e/run-sprint5-api.sh",
    "test:e2e:sprint8": "bash ./e2e/run-sprint8-api.sh",
    "test:e2e:sprint6-official": "PLAYWRIGHT_SKIP_WEBSERVER=1 pnpm --filter @scrm/e2e exec playwright test --project=sprint6-official",
    "test:build": "bash ./scripts/test/build-test.sh",
    "test:type": "bash ./scripts/test/type-check.sh",
    "test:report": "bash ./scripts/test/full-test.sh",
    "test:verbose": "bash ./scripts/test/full-test.sh",
    "start:all": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/start-all-services.ps1",
    "stop:all": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/stop-all-services.ps1",
    "check:services": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/check-services.ps1",
    "start:gateway": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/start-gateway.ps1",
    "start:auth": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/start-auth.ps1",
    "start:customer": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/start-customer.ps1",
    "start:acquisition": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/start-acquisition.ps1",
    "start:operation": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/start-operation.ps1",
    "start:asset": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/start-asset.ps1",
    "start:message": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/start-message.ps1",
    "start:integration": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/start-integration.ps1",
    "start:analytics": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/start-analytics.ps1",
    "start:finance": "chcp 65001 && powershell -ExecutionPolicy Bypass -File ./scripts/run/start-finance.ps1",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,jsx,json,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vue/eslint-config-typescript": "13",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^9.17.0",
    "prettier": "^3.0.3",
    "turbo": "^1.10.14",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.9.0"
}
